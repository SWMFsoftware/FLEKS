#DESCRIPTION
BC_DISCONTINUITY (TD): 2D tilted tangential discontinuity propagating into
the domain across both x-lo and y-lo inflow boundaries at 45 degrees
(normal = (1, 1, 0)). State 1 is defined in UNIFORMSTATE (without INFLOW),
and State 2 in DISCONTINUITY with exact total pressure balance.

#INITFROMSWMF
F                       initFromSWMF

#NORMALIZATION
1.0e5                   lNorm [m] (100 km)
1.0e6                   uNorm [m/s]

#GEOMETRY
0.0                     xMin
8.0                     xMax
0.0                     yMin
8.0                     yMax
0.0                     zMin
0.5                     zMax

#NCELL
16                      nCellX
16                      nCellY
1                       nCellZ

#MAXBLOCKSIZE
16                      maxBlockSizeX
16                      maxBlockSizeY
1                       maxBlockSizeZ

#PERIODICITY
F                       isPeriodicX
F                       isPeriodicY
T                       isPeriodicZ

#FIELDBOXBOUNDARY
inflow                  fieldBoxBoundaryLoX
outflow                 fieldBoxBoundaryHiX
inflow                  fieldBoxBoundaryLoY
outflow                 fieldBoxBoundaryHiY
periodic                fieldBoxBoundaryLoZ
periodic                fieldBoxBoundaryHiZ

#PARTICLEBOXBOUNDARY
inflow                  particleBoxBoundaryLoX
outflow                 particleBoxBoundaryHiX
inflow                  particleBoxBoundaryLoY
outflow                 particleBoxBoundaryHiY
periodic                particleBoxBoundaryLoZ
periodic                particleBoxBoundaryHiZ

#PLASMA
1                       nS
1.0                     mass
1.0                     charge

#PARTICLES
4                       npcelx
4                       npcely
1                       npcelz

#RANDOMPARTICLESLOCATION
F                       isParticleLocationRandom

#UNIFORMSTATE
5.0                     rho [/cc]
100.0                   ux [km/s]
100.0                   uy [km/s]
0.0                     uz [km/s]
100000.0                T [K]
0.0                     bx [T]
0.0                     by [T]
5.0e-9                  bz [T]
-5.0e-4                 ex [V/m]
5.0e-4                  ey [V/m]
0.0                     ez [V/m]

#DISCONTINUITY
td                      typeDiscontinuity
1.0                     normalX
1.0                     normalY
0.0                     normalZ
0.6                     width [code units]
0.0                     tStart [s]
10.0                    rho [/cc]
100.0                   ux [km/s]
100.0                   uy [km/s]
0.0                     uz [km/s]
96110.182               T [K]
0.0                     bx [T]
0.0                     by [T]
-3.0e-9                 bz [T]
-1.0                    vn [km/s]

#FIELDSOLVER
hybrid                  fieldSolverMode

#HALLTERM
F                       useHallTerm

#ELECTRONTEMPERATURE
0.0                     electronTemperature [eV]
1.0                     electronGamma
1.0                     electronDensity0

#FIELDSUBCYCLE
2                       nSubcycle

#TIMESTEPPING
T                       useFixedDt
0.05                    dt [s]

#SAVELOG
10                      dnSavePic
-1                      dnSavePT

#STOP
120                     nStep
6.0                     tMax

#SAVEPLOT
1                       nPlot
z=0 fluid ascii si      plotString
120                     dnSavePlot
-1                      dtSavePlot
-1                      dx
