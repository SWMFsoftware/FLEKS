#DESCRIPTION
Ionospheric body boundary (BODYIONOSPHERE): effusion of a hot H+ ionosphere,
n0 = 1 /cc and T = 1e5 K, from a sphere of radius 1.5 into vacuum. Hybrid PIC
with B = 0 and Te = 0, so E = 0 and the ions fly ballistically.

#INITFROMSWMF
F                       initFromSWMF

#GEOMETRY
-4.0                    xMin
 4.0                    xMax
-4.0                    yMin
 4.0                    yMax
-4.0                    zMin
 4.0                    zMax

#NCELL
24                      nCellX
24                      nCellY
24                      nCellZ

#MAXBLOCKSIZE
8                       maxBlockSizeX
8                       maxBlockSizeY
8                       maxBlockSizeZ

#PERIODICITY
F                       isPeriodicX
F                       isPeriodicY
F                       isPeriodicZ

#NORMALIZATION
1.0e5                   lNormSI
1.0e5                   uNormSI

#BODY
sphere                  type
1.5                     radius
0.0                     center x
0.0                     center y
0.0                     center z

#BODYBOUNDARY
absorb                  particleBoundary
insulating              fieldBoundary

#SOLVEEM
F                       solveEM

#HYBRIDPIC
T                       useHybridPIC

#HALLTERM
F                       useHallTerm

#RESISTIVITY
0.0                     etaResistivity

#ELECTRONTEMPERATURE
0.0                     electronTemperature [eV]
1.0                     electronGamma
1.0                     electronDensity0 [/cc] (prints the code unit of 1 /cc)

#BSUBCYCLE
1                       nBSubcycle

#PLASMA
1                       nSpecies
1.0                     mass
1.0                     charge

#UNIFORMSTATE
1.0e-8                  rho [/cc]  (near) vacuum
0.0                     ux
0.0                     uy
0.0                     uz
100000.0                T
0.0                     bx
0.0                     by
0.0                     bz
0.0                     ex
0.0                     ey
0.0                     ez

#FIELDBOXBOUNDARY
outflow                 x-
outflow                 x+
outflow                 y-
outflow                 y+
outflow                 z-
outflow                 z+

#PARTICLEBOXBOUNDARY
outflow                 x-
outflow                 x+
outflow                 y-
outflow                 y+
outflow                 z-
outflow                 z+

#BODYIONOSPHERE
1.0                     solarDirX
0.0                     solarDirY
0.0                     solarDirZ
1.0e-3                  cosSzaFloor
1.0                     n0 [/cc]
100000.0                T [K]
0.0                     szaExponent   uniform

#TIMESTEPPING
T                       useFixedDt
0.1                     dt

#PARTICLES
2                       npcelx
2                       npcely
2                       npcelz

#MONITOR
50                      dnReport
100                     dnReportLB
T                       doCompact

#SAVELOG
1                       dnSavePic
1                       dnSavePT

#STOP
-1                      MaxIter
20.0                    TimeMax
