#DESCRIPTION
Wave injection (Explicit Full PIC with subcycling): a Bz wave is injected at the x-lo boundary face via the WAVEBC boundary and propagates into a pure-EM domain with nSubcycle=2.

#INITFROMSWMF
F                       initFromSWMF

#GEOMETRY
-40.0                   xMin
 40.0                   xMax
-2.0                    yMin
 2.0                    yMax
-2.0                    zMin
 2.0                    zMax

#NCELL
80                      nCellX
4                       nCellY
4                       nCellZ

#MAXBLOCKSIZE
20                      maxBlockSizeX
4                       maxBlockSizeY
4                       maxBlockSizeZ

#PERIODICITY
F                       isPeriodicX
T                       isPeriodicY
T                       isPeriodicZ

#FIELDBOXBOUNDARY
wave                    fieldBoxBoundaryLo
outflow                 fieldBoxBoundaryHi
periodic                fieldBoxBoundaryLo
periodic                fieldBoxBoundaryHi
periodic                fieldBoxBoundaryLo
periodic                fieldBoxBoundaryHi

#PARTICLEBOXBOUNDARY
outflow                 particleBoxBoundaryLo
outflow                 particleBoxBoundaryHi
periodic                particleBoxBoundaryLo
periodic                particleBoxBoundaryHi
periodic                particleBoxBoundaryLo
periodic                particleBoxBoundaryHi

#FIELDSOLVER
explicit

#FIELDINTEGRATOR
leapfrog

#FIELDSUBCYCLE
2

#PLASMA
1                       nSpecies
0.01                    mass
-1.0                    charge

#UNIFORMSTATE
100.0                   rho
0.0                     ux
0.0                     uy
0.0                     uz
1.0e4                   T
0.0                     bx
0.0                     by
0.0                     bz
0.0                     ex
0.0                     ey
0.0                     ez

#NORMALIZATION
1.0                     lNormSI
1.0                     uNormSI

#PARTICLES
0                       nParticle
0                       nParticle
0                       nParticle

#WAVEBC
1                       nWaveFace
0                       direction
lo                      side
2                       nComp
0                       iField
-1                      iSpecies
0                       profile
1.0e-3                  amplitude
0.20                    frequency
31.41592653589793       waveLength
0.0                     phase
1.0                     dir_x
0.0                     dir_y
0.0                     dir_z
0.0                     pol_x
0.0                     pol_y
1.0                     pol_z
0.0                     tStart
-1.0                    tEnd
5.0                     rampTime
0.0                     tCenter
1.0                     tWidth
1                       iField
-1                      iSpecies
0                       profile
1.0e-3                  amplitude
0.20                    frequency
31.41592653589793       waveLength
0.0                     phase
1.0                     dir_x
0.0                     dir_y
0.0                     dir_z
0.0                     pol_x
1.0                     pol_y
0.0                     pol_z
0.0                     tStart
-1.0                    tEnd
5.0                     rampTime
0.0                     tCenter
1.0                     tWidth

#TIMESTEPPING
T                       useFixedDt
0.4                     dt

#MONITOR
10                      dnReport

#SAVELOG
1                       dnSavePic
-1                      dnSavePT

#DIVE
F                       doCorrectDivE

#RESAMPLING
F                       doReSampling

#SAVEPLOT
1                       nPlot
z=0 var ascii planet    plotString
-1                      dnSavePlot
40.0                    dtSavePlot
-1                      dxSavePlot
Ex Ey Ez Bx By Bz       plotVar

#STOP
-1                      MaxIter
40.0                    TimeMax
