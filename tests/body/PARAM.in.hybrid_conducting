#DESCRIPTION
Inner-body (absorbing sphere) test using the hybrid PIC solver: a uniform
plasma streams in +x past an absorbing sphere of radius 1.2 at the origin,
declared with BODY.

Variant: BODYBOUNDARY absorb + conducting.
Tangential E = 0 and radial B = 0 on the surface layer, interior B frozen.

#INITFROMSWMF
F                       initFromSWMF

#GEOMETRY
-3.2                    xMin   [code units]
 3.2                    xMax
-3.2                    yMin
 3.2                    yMax
-0.05                   zMin   one cell: the invariant direction
 0.05                   zMax

#NCELL
64                      nCellX
64                      nCellY
1                       nCellZ

#MAXBLOCKSIZE
16                      maxBlockSizeX
16                      maxBlockSizeY
1                       maxBlockSizeZ

#PERIODICITY
F                       isPeriodicX
T                       isPeriodicY
T                       isPeriodicZ

#FIELDBOXBOUNDARY
inflow                  fieldBoxBoundaryLo
outflow                 fieldBoxBoundaryHi
periodic                fieldBoxBoundaryLo
periodic                fieldBoxBoundaryHi
periodic                fieldBoxBoundaryLo
periodic                fieldBoxBoundaryHi

#PARTICLEBOXBOUNDARY
inflow                  particleBoxBoundaryLo
outflow                 particleBoxBoundaryHi
periodic                particleBoxBoundaryLo
periodic                particleBoxBoundaryHi
periodic                particleBoxBoundaryLo
periodic                particleBoxBoundaryHi

#INFLOW
5.0                     rho [amu/cc]
100.0                   ux [km/s]
0.0                     uy [km/s]
0.0                     uz [km/s]
314000.0                T [K]

#SOLVEEM
F                       solveEM

#HYBRIDPIC
T                       useHybridPIC

#HALLTERM
T                       useHallTerm

#MINIMUMDENSITY
0.05                    rhoMinOhm

#FIELDINTEGRATOR
rk4                     fieldIntegrator

#BSUBCYCLE
10                      nBSubcycle

#HYPERRESISTIVITY
0.0                     etaHyperSI
grid                    etaHyperMode
0.02                    etaHyperCh

#SMOOTHMOMENTS
T                       doSmoothMoments
2                       nSmoothMoments
0.5                     coefSmoothMoments

#PLASMA
1                       nS
1.0                     mass           Species 0: ions
1.0                     charge

#ELECTRONTEMPERATURE
27.06                   electronTemperature [eV]
1.6666666667            electronGamma
5.0                     electronDensity0

#UNIFORMSTATE
5.0                     rho [amu/cc]   Species 0: ions
100.0                   ux [km/s]      u_code = 1 (uNormSI = 1e5 m/s)
0.0                     uy [km/s]
0.0                     uz [km/s]
314000.0                T [K]
0.0                     bx [T]
3.0e-9                  by [T]         in-plane By: field lines drape around the cylinder
0.0                     bz [T]
0.0                     ex [V/m]
0.0                     ey [V/m]
-3.0e-4                 ez [V/m]       motional field E = -u x B = (0, 0, -ux * By)

#BODY
sphere                  type
1.2                     radius [code units]
0.0                     center [code units] x
0.0                     center [code units] y
0.0                     center [code units] z

#BODYBOUNDARY
absorb                  particleBoundary
conducting              fieldBoundary

#BODYHYPERRESISTIVITY
0.0                     etaBodyHyperSI      [m^4/s]
grid                    etaBodyHyperMode
0.05                    etaBodyHyperCh
1.8                     rOuter              [code units]
-1.0                    rInner              [code units, <0 defaults to body radius]

#TIMESTEPPING
T                       useFixedDt
0.02                    dt

#NORMALIZATION
1.0e5                   lNormSI   [m]
1.0e5                   uNormSI   [m/s]

#MONITOR
50                      dnReport

#SAVELOG
10                      dnSavePic
1                       dnSavePT

#PARTICLES
10                      npcelx
10                      npcely
1                       npcelz

#SAVEPLOT
1                       nPlot
z=0 var ascii pic       plotString
-1                      dn
2.0                     dt
1                       dx
body rhoS0 Ex Ey Ez Bx By Bz   plotVar

#STOP
-1                      MaxIter
2.0                     TimeMax

#RUN
