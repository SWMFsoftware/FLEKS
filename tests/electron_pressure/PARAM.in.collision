#DESCRIPTION
Evolved electron pressure: electron-ion collisional thermal equilibration test.
Uniform unmagnetized plasma with Ti != Te; verifies Braginskii heat exchange
rate (including 1/sqrt(m_p) unit conversion and 1 + dt*H point-implicit factor)
against exact ODE integration.

#INITFROMSWMF
F                       initFromSWMF

#GEOMETRY
-4.0                    xMin
 4.0                    xMax
-0.05                   yMin
 0.05                   yMax
-0.05                   zMin
 0.05                   zMax

#NCELL
16                      nCellX
1                       nCellY
1                       nCellZ

#MAXBLOCKSIZE
16                      maxBlockSizeX
1                       maxBlockSizeY
1                       maxBlockSizeZ

#PERIODICITY
T                       isPeriodicX
T                       isPeriodicY
T                       isPeriodicZ

#FIELDSOLVER
hybrid

#RESISTIVITY
0.0                     etaResistivity

#ELECTRONTEMPERATURE
10.0                    electronTemperature  [eV]
1.6666666666666667      electronGamma
1.0e4                   electronDensity0  [amu/cc]

#ELECTRONPRESSURE
T                       useElectronPressureEq
0.0                     heatCondKappa0SI
20.0                    coulombLog
T                       fieldAlignedConduction
1.0                     fieldAlignedFraction
1.0e-15                 fieldAlignedBMinSI
0.0                     heatFluxLimiter
0.0                     peMin
T                       ambipolarInStages

#ELECTRONCOLLISION
T                       useHeatExchange
1.0e4                   collisionFactor

#HALLTERM
F                       useHallTerm

#HYBRIDUPWIND
F                       useHybridUpwind

#BSUBCYCLE
1                       nBSubcycle

#SMOOTHE
F                       doSmoothE
0                       nSmoothE

#PLASMA
1                       nSpecies
1.0e4                   mass
1.0                     charge

#UNIFORMSTATE
1.0e4                   rho [/cc]
0.0                     ux [km/s]
0.0                     uy [km/s]
0.0                     uz [km/s]
2.0e6                   T [K]
0.0                     bx [T]
0.0                     by [T]
0.0                     bz [T]
0.0                     ex [V/m]
0.0                     ey [V/m]
0.0                     ez [V/m]

#TIMESTEPPING
T                       useFixedDt
0.05                    dt

#NORMALIZATION
1.0e5                   lNormSI
1.0e5                   uNormSI

#MONITOR
20                      dnReport

#SAVELOG
10                      dnSavePic
10                      dnSavePT

#PARTICLES
200                     nParticle per cell in X
1                       nParticle per cell in Y
1                       nParticle per cell in Z

#SAVEPLOT
1                       nPlot
z=0 var ascii pic       plotString
20                      dn
0.0                     dt
1                       dx
Pe pS0 rhoS0            plotVar

#STOP
-1                      MaxIter
5.0                     TimeMax
