#DESCRIPTION
Evolved electron pressure: 2-level AMR advection test.
A 2D periodic IonAcousticWave drifts across a 2x refined patch under uniform
bulk flow (ux = 100 km/s, uy = 50 km/s) with heatCondKappa0SI = 0. Verifies
that coarse-fine ghost fills keep Pe/rho^gamma flat across the AMR interface.

#INITFROMSWMF
F                       initFromSWMF

#GEOMETRY
-8.0                    xMin
 8.0                    xMax
-4.0                    yMin
 4.0                    yMax
-0.5                    zMin
 0.5                    zMax

#NCELL
32                      nCellX
16                      nCellY
1                       nCellZ

#MAXBLOCKSIZE
8                       maxBlockSizeX
8                       maxBlockSizeY
1                       maxBlockSizeZ

#PERIODICITY
T                       isPeriodicX
T                       isPeriodicY
T                       isPeriodicZ

#FIELDSOLVER
hybrid

#RESISTIVITY
0.0                     etaResistivity

#ELECTRONTEMPERATURE
62.8                    electronTemperature  [eV]
1.6666666666666667      electronGamma
1.0                     electronDensity0  [amu/cc]

#ELECTRONPRESSURE
T                       useElectronPressureEq
0.0                     heatCondKappa0SI
20.0                    coulombLog
T                       fieldAlignedConduction
1.0                     fieldAlignedFraction
1.0e-15                 fieldAlignedBMinSI
0.0                     heatFluxLimiter
0.0                     peMin
T                       ambipolarInStages

#HALLTERM
F                       useHallTerm

#HYBRIDUPWIND
F                       useHybridUpwind

#BSUBCYCLE
1                       nBSubcycle

#SMOOTHMOMENTS
F                       doSmoothMoments
0                       nSmoothMoments
0.5                     coefSmoothMoments

#SMOOTHE
F                       doSmoothE
0                       nSmoothE

#PLASMA
1                       nSpecies
1.0e4                   mass
1.0                     charge

#UNIFORMSTATE
1.0                     rho [/cc]
200.0                   ux [km/s]
100.0                   uy [km/s]
0.0                     uz [km/s]
10000.0                 T [K]
0.0                     bx [T]
0.0                     by [T]
0.0                     bz [T]
0.0                     ex [V/m]
0.0                     ey [V/m]
0.0                     ez [V/m]

#TESTCASE
IonAcousticWave
0.20                    pert
1                       waveMode

#TIMESTEPPING
T                       useFixedDt
0.02                    dt

#NORMALIZATION
1.0e5                   lNormSI
1.0e5                   uNormSI

#MONITOR
25                      dnReport

#SAVELOG
10                      dnSavePic
10                      dnSavePT

#PARTICLES
16                      nParticle per cell in X
16                      nParticle per cell in Y
1                       nParticle per cell in Z

#SAVEPLOT
1                       nPlot
z=0 var ascii pic       plotString
25                      dn
0.0                     dt
-1                      dx
Pe rhoS0                plotVar

#REGION
patch                   name
box                     shape
-4.0                    xMin
 4.0                    xMax
-2.0                    yMin
 2.0                    yMax
-0.5                    zMin
 0.5                    zMax

#REFINEREGION
0                       iLev
+patch                  regions

#GRIDEFFICIENCY
1.0                     gridEfficiency

#CONSTANTPPV
F                       isPPVconstant

#STOP
-1                      MaxIter
2.0                     TimeMax
