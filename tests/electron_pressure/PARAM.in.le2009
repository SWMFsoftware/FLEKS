#DESCRIPTION
Anisotropic electron pressure (Le et al. 2009 trapped-passing EOS): algebraic
closure bridging Boltzmann and CGL limits with #ELECTRONPRESSURE F. Checks
pointwise PePar/PePerp, Pe, TePar/TePerp against the closed-form Le et al.
(2009) expressions for n/n0 != 1 and B/B0 != 1.

#INITFROMSWMF
F                       initFromSWMF

#GEOMETRY
-8.0                    xMin
 8.0                    xMax
-0.05                   yMin
 0.05                   yMax
-0.05                   zMin
 0.05                   zMax

#NCELL
48                      nCellX
1                       nCellY
1                       nCellZ

#MAXBLOCKSIZE
24                      maxBlockSizeX
1                       maxBlockSizeY
1                       maxBlockSizeZ

#PERIODICITY
T                       isPeriodicX
T                       isPeriodicY
T                       isPeriodicZ

#FIELDSOLVER
hybrid

#RESISTIVITY
0.0                     etaResistivity

#ELECTRONTEMPERATURE
62.8                    electronTemperature  [eV]
1.6666666666666667      electronGamma
1.0                     electronDensity0  [amu/cc]

#ELECTRONPRESSURE
F                       useElectronPressureEq

#ELECTRONANISO
le2009                  electronAnisoModel
F                       usePeInstabilityLimit
1.5e-8                  le2009B0SI  [T]

#HALLTERM
F                       useHallTerm

#HYBRIDUPWIND
F                       useHybridUpwind

#BSUBCYCLE
1                       nBSubcycle

#SMOOTHMOMENTS
T                       doSmoothMoments
2                       nSmoothMoments
0.5                     coefSmoothMoments

#SMOOTHE
T                       doSmoothE
2                       nSmoothE

#PLASMA
1                       nSpecies
1.0                     mass
1.0                     charge

#UNIFORMSTATE
1.0                     rho [/cc]
0.0                     ux [km/s]
0.0                     uy [km/s]
0.0                     uz [km/s]
400000.0                T [K]
1.0439e-8               bx [T]
0.0                     by [T]
0.0                     bz [T]
0.0                     ex [V/m]
0.0                     ey [V/m]
0.0                     ez [V/m]

#TESTCASE
IonAcousticWave
0.25                    pert
1                       waveMode

#TIMESTEPPING
T                       useFixedDt
0.02                    dt

#NORMALIZATION
1.0e5                   lNormSI
1.0e5                   uNormSI

#MONITOR
25                      dnReport

#SAVELOG
10                      dnSavePic
10                      dnSavePT

#PARTICLES
2000                    nParticle per cell in X
1                       nParticle per cell in Y
1                       nParticle per cell in Z

#SAVEPLOT
1                       nPlot
z=0 var ascii pic       plotString
25                      dn
0.0                     dt
1                       dx
Pe PePar PePerp Te TePar TePerp Bx By Bz rhoS0 plotVar

#STOP
-1                      MaxIter
1.0                     TimeMax
