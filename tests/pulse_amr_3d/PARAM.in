#DESCRIPTION
3D Alfvén pulse propagation across a central 3D AMR box with hybrid PIC

#INITFROMSWMF
F                       initFromSWMF

#GEOMETRY
-4.0                    xMin
 4.0                    xMax
-2.0                    yMin
 2.0                    yMax
-1.0                    zMin
 1.0                    zMax

#NCELL
32                      nCellX
16                      nCellY
8                       nCellZ

#MAXBLOCKSIZE
16                      maxBlockSizeX
8                       maxBlockSizeY
4                       maxBlockSizeZ

#PERIODICITY
T                       isPeriodicX
T                       isPeriodicY
T                       isPeriodicZ

#FIELDBOXBOUNDARY
periodic
periodic
periodic
periodic
periodic
periodic

#PARTICLEBOXBOUNDARY
periodic
periodic
periodic
periodic
periodic
periodic

#SOLVEEM
F                       solveEM

#HYBRIDPIC
T                       useHybridPIC
T                       syncEmfAmr
T                       ctRestrictB
T                       evolveGhostB

#RESISTIVITY
0.0                     etaResistivity

#ELECTRONTEMPERATURE
10.0                    electronTemperature
1.0                     electronGamma
1.0                     electronDensity0

#FIELDINTEGRATOR
rk4                     fieldIntegrator

#BSUBCYCLE
4                       nBSubcycle

#PLASMA
1                       nSpecies
1.0                     mass
1.0                     charge

#UNIFORMSTATE
1.0                     rho [/cc]
0.0                     ux [km/s]
0.0                     uy [km/s]
0.0                     uz [km/s]
116045.0                T [K]
1.0e-9                  bx [T]
0.0                     by [T]
0.0                     bz [T]
0.0                     ex [V/m]
0.0                     ey [V/m]
0.0                     ez [V/m]

#TESTCASE
AlfvenPulse             testCase

#PARTICLES
4                       nParticle per cell in X
4                       nParticle per cell in Y
2                       nParticle per cell in Z

#TIMESTEPPING
T                       useFixedDt
0.01                    dt

#NORMALIZATION
1.0e5                   lNormSI
1.0e5                   uNormSI

#MONITOR
5                       dnReport

#DIVB
F                       useHyperbolicCleaning
T                       alwaysComputeDivB

#SAVELOG
1                       dnSavePic
1                       dnSavePT

#SAVEPLOT
1                       nPlot
z=0 fluid ascii planet  plotString
-1                      dnSavePlot
1.0                     dtSavePlot
-1                      dxSavePlot

#REGION
center_box              name
box                     shape
-2.0                    min
 2.0                    max
-1.0                    min
 1.0                    max
-0.5                    min
 0.5                    max

#REFINEREGION
0                       iLev
+center_box             regions

#GRIDEFFICIENCY
1.0                     gridEfficiency

#CONSTANTPPV
F                       isPPVconstant

#STOP
20                      MaxIter
-1.0                    TimeMax
