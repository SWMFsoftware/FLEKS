#DESCRIPTION
Non-periodic semi-implicit PIC AMR inflow + div(E) boundary regression test.

Drifting field-aligned plasma enters a 3D 2-level AMR box through an inflow x+
boundary separated from L1 by only 2 L0 cells, exercising div(E) guards,
pre-splitting inflow scaling, and the Pic::SetTargetPPC clearance warning.

#INITFROMSWMF
F                       initFromSWMF

#GEOMETRY
-2.0                    xMin
 1.5                    xMax
-2.0                    yMin
 2.0                    yMax
-2.0                    zMin
 2.0                    zMax

#NCELL
14                      nCellX
16                      nCellY
16                      nCellZ

#MAXBLOCKSIZE
8                       maxBlockSizeX
8                       maxBlockSizeY
8                       maxBlockSizeZ

#PERIODICITY
F                       isPeriodicX
T                       isPeriodicY
T                       isPeriodicZ

#PLANETRADIUS
3396000.0               radius [m]

#NORMALIZATION
3396000.0               lNormSI
3000000.0               uNormSI

#PLASMA
2                       nSpecies
0.0625                  mass        Species 0: electron
-1.0                    charge
1.0                     mass        Species 1: H+
1.0                     charge

#INFLOW
1.0                     rho [/cc]   Species 0: electron
-300.0                  ux [km/s]
0.0                     uy [km/s]
0.0                     uz [km/s]
60000.0                 T [K]
1.0                     rho [/cc]   Species 1: H+
-300.0                  ux [km/s]
0.0                     uy [km/s]
0.0                     uz [km/s]
60000.0                 T [K]

#UNIFORMSTATE
1.0                     rho [/cc]   Species 0: electron
-300.0                  ux [km/s]
0.0                     uy [km/s]
0.0                     uz [km/s]
60000.0                 T [K]
1.0                     rho [/cc]   Species 1: H+
-300.0                  ux [km/s]
0.0                     uy [km/s]
0.0                     uz [km/s]
60000.0                 T [K]
-2.0e-9                 bx [T]      field-aligned (E = -u x B = 0)
0.0                     by [T]
0.0                     bz [T]
0.0                     ex [V/m]
0.0                     ey [V/m]
0.0                     ez [V/m]

#FIELDBOXBOUNDARY
outflow                 fieldBoxBoundaryLo
inflow                  fieldBoxBoundaryHi
periodic                fieldBoxBoundaryLo
periodic                fieldBoxBoundaryHi
periodic                fieldBoxBoundaryLo
periodic                fieldBoxBoundaryHi

#PARTICLEBOXBOUNDARY
open                    particleBoxBoundaryLo
inflow                  particleBoxBoundaryHi
periodic                particleBoxBoundaryLo
periodic                particleBoxBoundaryHi
periodic                particleBoxBoundaryLo
periodic                particleBoxBoundaryHi

#TIMESTEPPING
T                       useFixedDt
0.1                     dt

#FIELDSOLVER
implicit

#EFIELDSOLVER
1.0e-6                  EFieldTol
200                     EFieldIter
amrex                   solverType
auto                    precondType

#COMOVING
T                       solveFieldInCoMov
5                       nSmoothBackGroundU

#UPWINDE
T                       useUpwindE
1                       limiterThetaE

#UPWINDB
T                       useUpwindB
1                       limiterThetaB
curl                    typeUpwindB

#SMOOTHJ
T                       doSmoothJ
1                       nSmoothJ
0.5                     coefSmoothJ

#DIVE
T                       doCorrectDivE
1                       nDivECorrection
amrex                   solverType
jacobi                  precondType

#PARTICLES
2                       npcelx
2                       npcely
2                       npcelz

#PRESPLITTING
T                       doPreSplitting

#RESAMPLING
T                       doReSampling
0.8                     reSamplingLowLimit
1.8                     reSamplingHighLimit
9.0                     maxWeightRatio

#CONSTANTPPV
F                       isPPVconstant

#MONITOR
10                      dnReport

#SAVELOG
10                      dnSavePic
10                      dnSavePT

#SAVEPLOT
1                       nPlot
z=0 var ascii planet    plotString
-1                      dnSavePlot
4.0                     dtSavePlot
-1                      dxSavePlot
{fluid} qc divEc ppcS0 ppcS1    varName

#REGION
inner_cube              name
box                     shape
-1.0                    min
 1.0                    max
-1.0                    min
 1.0                    max
-1.0                    min
 1.0                    max

#REFINEREGION
0                       refineLev
+inner_cube             StringRegion

#GRIDEFFICIENCY
1.0                     gridEfficiency

#STOP
-1                      MaxIter
8.0                     TimeMax
