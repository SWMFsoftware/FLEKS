#DESCRIPTION
Non-periodic 3D semi-implicit PIC AMR inflow, div(E), and co-moving intrinsic-B
regression test.

Drifting solar wind enters from x+ past a refined inner cube and an absorbing
ambipolar spherical inner body carrying an intrinsic dipole field B0. Exercises:
1. Smooth div(E) cleaning across non-periodic coarse-fine refinement boundaries
   (side/tail outflow and upstream inflow) and around an ambipolar inner body.
2. Co-moving frame background velocity restriction across AMR levels and
   inclusion of B0 in eBg = -uBg x (B1 + B0).

#INITFROMSWMF
F                       initFromSWMF

#GEOMETRY
-2.0                    xMin
 2.0                    xMax
-2.0                    yMin
 2.0                    yMax
-2.0                    zMin
 2.0                    zMax

#NCELL
16                      nCellX
16                      nCellY
16                      nCellZ

#MAXBLOCKSIZE
8                       maxBlockSizeX
8                       maxBlockSizeY
8                       maxBlockSizeZ

#PERIODICITY
F                       isPeriodicX
F                       isPeriodicY
F                       isPeriodicZ

#PLANETRADIUS
3396000.0               radius [m]

#NORMALIZATION
3396000.0               lNormSI
3000000.0               uNormSI

#BODY
sphere                  type
0.45                    radius [code units]
0.0                     center x
0.0                     center y
0.0                     center z

#BODYBOUNDARY
ambipolar               particleBoundary
linetied                fieldBoundary

#DIPOLE
30.0                    strength [nT] at rRef
0.0                     theta [deg]   dipole moment along +z -> B0_z < 0 at z=0
0.0                     phi [deg]
-1.0                    rRef [m]      <0 -> use BODY radius

#PLASMA
2                       nSpecies
0.0625                  mass        Species 0: electron
-1.0                    charge
1.0                     mass        Species 1: H+
1.0                     charge

#INFLOW
2.0                     rho [/cc]   Species 0: electron
-300.0                  ux [km/s]
0.0                     uy [km/s]
0.0                     uz [km/s]
60000.0                 T [K]
2.0                     rho [/cc]   Species 1: H+
-300.0                  ux [km/s]
0.0                     uy [km/s]
0.0                     uz [km/s]
60000.0                 T [K]

#UNIFORMSTATE
2.0                     rho [/cc]   Species 0: electron
-300.0                  ux [km/s]
0.0                     uy [km/s]
0.0                     uz [km/s]
60000.0                 T [K]
2.0                     rho [/cc]   Species 1: H+
-300.0                  ux [km/s]
0.0                     uy [km/s]
0.0                     uz [km/s]
60000.0                 T [K]
0.0                     bx [T]
1.5e-9                  by [T]
0.0                     bz [T]      convection Ez = -ux * By = +450 uV/m
0.0                     ex [V/m]
0.0                     ey [V/m]
4.5e-4                  ez [V/m]

#FIELDBOXBOUNDARY
outflow                 fieldBoxBoundaryLo
inflow                  fieldBoxBoundaryHi
outflow                 fieldBoxBoundaryLo
outflow                 fieldBoxBoundaryHi
outflow                 fieldBoxBoundaryLo
outflow                 fieldBoxBoundaryHi

#PARTICLEBOXBOUNDARY
open                    particleBoxBoundaryLo
inflow                  particleBoxBoundaryHi
open                    particleBoxBoundaryLo
open                    particleBoxBoundaryHi
open                    particleBoxBoundaryLo
open                    particleBoxBoundaryHi

#TIMESTEPPING
T                       useFixedDt
0.1                     dt

#FIELDSOLVER
implicit

#DISCRETIZATION
0.52                    theta
0.0                     ratioDivC2C

#EFIELDSOLVER
1.0e-6                  EFieldTol
200                     EFieldIter
amrex                   solverType
auto                    precondType

#COMOVING
T                       solveFieldInCoMov
5                       nSmoothBackGroundU

#UPWINDE
T                       useUpwindE
1                       limiterThetaE

#UPWINDB
T                       useUpwindB
1                       limiterThetaB
curl                    typeUpwindB

#SMOOTHJ
T                       doSmoothJ
1                       nSmoothJ
0.5                     coefSmoothJ

#DIVE
T                       doCorrectDivE
1                       nDivECorrection
amrex                   solverType
jacobi                  precondType

#PARTICLES
2                       npcelx
2                       npcely
2                       npcelz

#PRESPLITTING
T                       doPreSplitting

#RESAMPLING
T                       doReSampling
0.8                     reSamplingLowLimit
1.8                     reSamplingHighLimit
9.0                     maxWeightRatio

#CONSTANTPPV
F                       isPPVconstant

#MONITOR
10                      dnReport

#SAVELOG
5                       dnSavePic
5                       dnSavePT

#SAVEPLOT
1                       nPlot
z=0 var ascii planet    plotString
-1                      dnSavePlot
5.0                     dtSavePlot
-1                      dxSavePlot
{fluid} B0x B0y B0z qc divEc body ppcS0 ppcS1    varName

#REGION
inner_cube              name
box                     shape
-1.0                    min
 1.0                    max
-1.0                    min
 1.0                    max
-1.0                    min
 1.0                    max

#REFINEREGION
0                       refineLev
+inner_cube             StringRegion

#GRIDEFFICIENCY
1.0                     gridEfficiency

#STOP
-1                      MaxIter
5.0                     TimeMax
