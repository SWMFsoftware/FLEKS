#DESCRIPTION
Open particle boundary drift test: a uniform plasma of H+ and O+ at T = 1e5 K
drifting along +x at 57.4 km/s (2 sigma of H+, 8 sigma of O+), entering at x-
via inflow and leaving through x+, with flanks at y- and y+. Hybrid PIC with B = 0
and Te = 0, so E = 0.

#INITFROMSWMF
F                       initFromSWMF

#GEOMETRY
-4.0                    xMin
 4.0                    xMax
-4.0                    yMin
 4.0                    yMax

#NCELL
24                      nCellX
24                      nCellY

#MAXBLOCKSIZE
8                       maxBlockSizeX
8                       maxBlockSizeY

#PERIODICITY
F                       isPeriodicX
F                       isPeriodicY

#NORMALIZATION
1.0e5                   lNormSI
1.0e5                   uNormSI

#SOLVEEM
F                       solveEM

#HYBRIDPIC
T                       useHybridPIC

#HALLTERM
F                       useHallTerm

#RESISTIVITY
0.0                     etaResistivity

#ELECTRONTEMPERATURE
0.0                     electronTemperature [eV]
1.0                     electronGamma
1.0                     electronDensity0 [/cc]

#BSUBCYCLE
1                       nBSubcycle

#PLASMA
2                       nSpecies
1.0                     mass        Species 0: H+
1.0                     charge
16.0                    mass        Species 1: O+
1.0                     charge

#UNIFORMSTATE
1.0                     rho [/cc]  Species 0: H+
57.4                    ux [km/s]
0.0                     uy
0.0                     uz
100000.0                T [K]      sigma = 28.7 km/s
1.0                     rho [/cc]  Species 1: O+
57.4                    ux [km/s]
0.0                     uy
0.0                     uz
100000.0                T [K]      sigma = 7.2 km/s
0.0                     bx
0.0                     by
0.0                     bz
0.0                     ex
0.0                     ey
0.0                     ez

#FIELDBOXBOUNDARY
fixed                   x-
outflow                 x+
outflow                 y-
outflow                 y+

#INFLOW
1.0                     rho [/cc]  Species 0: H+
57.4                    ux [km/s]
0.0                     uy
0.0                     uz
100000.0                T [K]
1.0                     rho [/cc]  Species 1: O+
57.4                    ux [km/s]
0.0                     uy
0.0                     uz
100000.0                T [K]

#PARTICLEBOXBOUNDARY
inflow                  x-
open                    x+
open                    y-
open                    y+

#FIELDINTEGRATOR
rk4-pc                  fieldIntegrator

#TIMESTEPPING
T                       useFixedDt
0.1                     dt

#PARTICLES
3                       npcelx
3                       npcely

#MONITOR
50                      dnReport
100                     dnReportLB
T                       doCompact

#SAVELOG
1                       dnSavePic
1                       dnSavePT

#STOP
-1                      MaxIter
6.0                     TimeMax
