#DESCRIPTION
Ion Beam R-mode Instability Standalone Test - HYBRID PIC
Kinetic ions (core + 10% beam) with massless fluid electrons (Ohm's law).
Resonant electromagnetic ion beam instability (Matthews 1994, Munoz et al. 2018).

#INITFROMSWMF
F                       initFromSWMF

#GEOMETRY
-5e3                    xMin  [Lx = 10,000 km, resonant mode fits in box]
 5e3                    xMax
-1.0                    yMin
 1.0                    yMax
-1.0                    zMin
 1.0                    zMax

#NCELL
64                      nCellX
1                       nCellY
1                       nCellZ

#MAXBLOCKSIZE
64                      maxBlockSizeX
1                       maxBlockSizeY
1                       maxBlockSizeZ

#PERIODICITY
T                       isPeriodicX
T                       isPeriodicY
T                       isPeriodicZ

#SOLVEEM
F                       solveEM

#HYBRIDPIC
T                       useHybridPIC

#HALLTERM
T                       useHallTerm

#BSUBCYCLE
1                       nBSubcycle

#RESISTIVITY
0.0                     etaResistivity

#ELECTRONTEMPERATURE
0.0                     electronTemperature
1.0                     electronGamma
1.0                     electronDensity0

#PLASMA
1                       nSpecies
1.0                     mass
1.0                     charge

#UNIFORMSTATE
5.0                     rho [amu/cc]
-0.4                    ux [km/s normalized; -400 km/s background]
0.0                     uy
0.0                     uz
10000.0                 T [K]
5.0e-9                  bx [T, 5 nT guide field]
0.0                     by
0.0                     bz
0.0                     ex
0.0                     ey
0.0                     ez

#TESTCASE
Beam
0                       iSpecies
0.10                    ratio [10% beam density]
1.2                     vel   [+1200 km/s beam velocity; Delta v = 1600 km/s]
0.0                     vel
0.0                     vel

#SMOOTHMOMENTS
T                       doSmoothMoments
1                       nSmoothMoments
0.5                     coefSmoothMoments

#TIMESTEPPING
T                       useFixedDt
0.002                   dt

#NORMALIZATION
1000.0                  lNormSI
1.0e6                   uNormSI

#MONITOR
50                      dnReport

#SAVELOG
10                      dnSavePic
10                      dnSavePT

#PARTICLES
500                     nParticle per cell in X
1                       nParticle per cell in Y
1                       nParticle per cell in Z

#SAVEPLOT
1                       nPlot
z=0 fluid ascii pic     plotString
-1                      dn
0.04                    dt
1                       dx

#STOP
-1                      MaxIter
0.2                     TimeMax

#RUN
