#DESCRIPTION
Ionospheric emission shell with the photochemistry profile
(IONOSPHEREEMISSIONPROFILE): the weights follow the photoionization column of an
optically thick layer (tau = 100) below the shell, which is proportional to
cos(SZA), with exponent 0.5.
Hybrid PIC with B = 0 and Te = 0, so E = 0 and the ions fly ballistically.

#INITFROMSWMF
F                       initFromSWMF

#GEOMETRY
-4.0                    xMin
 4.0                    xMax
-4.0                    yMin
 4.0                    yMax
-4.0                    zMin
 4.0                    zMax

#NCELL
24                      nCellX
24                      nCellY
24                      nCellZ

#MAXBLOCKSIZE
8                       maxBlockSizeX
8                       maxBlockSizeY
8                       maxBlockSizeZ

#PERIODICITY
F                       isPeriodicX
F                       isPeriodicY
F                       isPeriodicZ

#NORMALIZATION
1.0e5                   lNormSI
1.0e5                   uNormSI

#BODY
sphere                  type
1.5                     radius
0.0                     center x
0.0                     center y
0.0                     center z

#BODYBOUNDARY
absorb                  particleBoundary
insulating              fieldBoundary

#SOLVEEM
F                       solveEM

#HYBRIDPIC
T                       useHybridPIC

#HALLTERM
F                       useHallTerm

#RESISTIVITY
0.0                     etaResistivity

#ELECTRONTEMPERATURE
0.0                     electronTemperature [eV]
1.0                     electronGamma
1.0                     electronDensity0 [/cc] (prints the code unit of 1 /cc)

#BSUBCYCLE
1                       nBSubcycle

#PLASMA
3                       nSpecies
0.0625                  mass        Species 0: fluid electron slot
-1.0                    charge
1.0                     mass        Species 1: H+
1.0                     charge
16.0                    mass        Species 2: O+
1.0                     charge

#UNIFORMSTATE
2.0e-12                 rho [/cc]  Species 0
0.0                     ux
0.0                     uy
0.0                     uz
100000.0                T
1.0e-12                 rho [/cc]  (near) vacuum: 5e11 ions, negligible
0.0                     ux
0.0                     uy
0.0                     uz
100000.0                T
1.0e-12                 rho [/cc]
0.0                     ux
0.0                     uy
0.0                     uz
100000.0                T
0.0                     bx
0.0                     by
0.0                     bz
0.0                     ex
0.0                     ey
0.0                     ez

#FIELDBOXBOUNDARY
outflow                 x-
outflow                 x+
outflow                 y-
outflow                 y+
outflow                 z-
outflow                 z+

#PARTICLEBOXBOUNDARY
outflow                 x-
outflow                 x+
outflow                 y-
outflow                 y+
outflow                 z-
outflow                 z+

#IONOSPHEREEMISSION
2.0e5                   radius [m] = 2 code units
1.0                     solarDirX
0.0                     solarDirY
0.0                     solarDirZ
1.0                     noon
0.1                     night
4                       particlesPerCell
0.0                     totalRate [#/s]  Species 0: fluid electron (no particles)
100000.0                T [K]
1.0e16                  totalRate [#/s]  Species 1: H+
100000.0                T [K]
2.0e15                  totalRate [#/s]  Species 2: O+
100000.0                T [K]

#IONOSPHEREEMISSIONPROFILE
photochemistry          type
0.5                     exponent

#PLANETRADIUS
1.5e5                   radius [m] = body radius

#EXOSPHERE
Exponential             typeProfile
1                       nComponent
1.0e12                  n0 [m^-3]
1000.0                  H0 [m]
100.0                   T0 [K]
0.0                     k0

#PHOTOIONIZATION
1.0e-3                  nuPhoto0 [1/s]

#OPTICALDEPTH
1.0e-13                 crossSection [m^2]  tau = n0 sigma H0 = 100
-1                      scaleHeight [m]
1.0                     solarDirX
0.0                     solarDirY
0.0                     solarDirZ
F                       chapmanFunction
1.0e-10                 minProduction
6.0e-3                  tauFloor
11.5                    tauCutoff
5.0e-4                  cosSzaFloor

#PHOTOCHEMICALBOUNDARY
2.0e5                   radius [m]  the layer feeds only the emission

#SOURCE
T                       useSource

#TIMESTEPPING
T                       useFixedDt
0.1                     dt

#PARTICLES
2                       npcelx
2                       npcely
2                       npcelz

#MONITOR
50                      dnReport
100                     dnReportLB
T                       doCompact

#SAVELOG
1                       dnSavePic
1                       dnSavePT

#SAVEPLOT
1                       nPlot
3d var ascii si         plotString
1                       dn   step 1 holds only the particles of one injection
-1.0                    dt
1                       dx
rhoS1 rhoS2             NameVars

#STOP
-1                      MaxIter
2.0                     TimeMax
